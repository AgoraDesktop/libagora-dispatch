module Dispatch {
	requires blocks
	export *
	link "agora-dispatch"
	link "BlocksRuntime"
}

module DispatchIntrospection [system] [extern_c] {
	header "introspection.h"
	export *
}

module CDispatch [system] [extern_c] {
	umbrella header "dispatch.h"
	export *
	requires blocks
	link "agora-dispatch"
}
